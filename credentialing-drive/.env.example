# Core Google Cloud configuration
GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE=your-firestore-database-id

# Google OAuth web client. Add GOOGLE_REDIRECT_URI in the OAuth client's
# authorized redirect URI list before starting the connection flow.
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback

# Drive watch notifications require an HTTPS URL reachable by Google Drive.
GOOGLE_DRIVE_WEBHOOK_URL=https://your-service-url/webhooks/google-drive
DRIVE_WATCH_RENEWAL_TOKEN=replace-with-a-long-random-secret

# OCR and Gemini
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-document-ai-processor-id
VERTEX_AI_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Cloud Tasks worker configuration
CLOUD_TASKS_LOCATION=us-east1
CLOUD_TASKS_QUEUE=drive-document-processing
TASK_PROCESSOR_URL=https://your-service-url/tasks/process-drive-file
TASK_INVOKER_SERVICE_ACCOUNT=credentialing-drive-tasks@your-gcp-project-id.iam.gserviceaccount.com

# Optional reporting. Firestore remains the system of record when BigQuery is unavailable.
BIGQUERY_REPORTING_DATASET=credentialing_reporting

# Keep false outside controlled replay testing.
ALLOW_DUPLICATE_DRIVE_IMPORTS=false
