# Core Google Cloud configuration
GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE=your-firestore-database-id

# Google OAuth web client. Add GOOGLE_REDIRECT_URI in the OAuth client's
# authorized redirect URI list before starting the connection flow.
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback

# Clerk Authentication. The publishable key and Frontend API URL are browser-safe;
# the secret and JWT public key belong only on the server.
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_FRONTEND_API_URL=https://your-instance.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_your-secret-key
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CLERK_AUTHORIZED_PARTIES=http://localhost:8080,http://127.0.0.1:8080,https://your-service-url
# Development Clerk session tokens can omit the azp claim. Use only with sk_test_
# keys; the app refuses this compatibility mode when a live key is configured.
CLERK_ALLOW_MISSING_AZP=false
# Server-controlled destination for Clerk organization invitation links.
APP_BASE_URL=http://127.0.0.1:8080

# Better Auth migration. Set AUTH_PROVIDER=better_auth only after the auth
# service has run its PostgreSQL migration and every entity has been linked to
# a Better Auth organization. The database URL is server-only.
AUTH_PROVIDER=clerk
# Local development only: creates a loopback-only super-admin context so the
# dashboard can be used before Better Auth or Clerk is running. Never enable
# this outside localhost.
LOCAL_DEV_AUTH_BYPASS=false
BETTER_AUTH_URL=http://127.0.0.1:8787
BETTER_AUTH_JWT_AUDIENCE=http://127.0.0.1:8080
BETTER_AUTH_DATABASE_URL=postgresql://cozema_auth:local-password@127.0.0.1:5432/cozema_auth
BETTER_AUTH_GOOGLE_SIGN_IN_ENABLED=false
COZEMA_PLATFORM_ADMIN_EMAILS=
AUTH_EVENT_WEBHOOK_SECRET=generate-a-different-long-random-value

# Drive watch notifications require an HTTPS URL reachable by Google Drive.
GOOGLE_DRIVE_WEBHOOK_URL=https://your-service-url/webhooks/google-drive
# The renewal endpoint accepts only a Google-signed OIDC token minted for this
# Scheduler service account and audience. It does not use a shared secret.
DRIVE_WATCH_RENEWAL_SERVICE_ACCOUNT=credentialing-drive-scheduler@your-gcp-project-id.iam.gserviceaccount.com
DRIVE_WATCH_RENEWAL_AUDIENCE=https://your-service-url
# Retained for manually invoked /internal maintenance endpoints only.
DRIVE_WATCH_RENEWAL_TOKEN=replace-with-a-long-random-secret

# OCR and Gemini
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-document-ai-processor-id
VERTEX_AI_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
# This is a fresh second-pass model call over repeated provider records.
GEMINI_RECONCILIATION_MODEL=gemini-2.5-flash
RECONCILIATION_ENABLED=true

# Cloud Tasks worker configuration
CLOUD_TASKS_LOCATION=us-east1
CLOUD_TASKS_QUEUE=drive-document-processing
TASK_PROCESSOR_URL=https://your-service-url/tasks/process-drive-file
TASK_INVOKER_SERVICE_ACCOUNT=credentialing-drive-tasks@your-gcp-project-id.iam.gserviceaccount.com

# Optional reporting. Firestore remains the system of record when BigQuery is unavailable.
BIGQUERY_REPORTING_DATASET=credentialing_reporting

# Keep false outside controlled replay testing.
ALLOW_DUPLICATE_DRIVE_IMPORTS=false
