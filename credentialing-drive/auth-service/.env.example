# The Better Auth service only accepts requests from these browser origins.
BETTER_AUTH_URL=http://127.0.0.1:8787
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8080
BETTER_AUTH_SECRET=generate-a-long-random-value-at-least-32-characters
BETTER_AUTH_JWT_AUDIENCE=http://127.0.0.1:8080
DATABASE_URL=postgresql://cozema_auth:local-password@127.0.0.1:5432/cozema_auth

# Leave blank locally to print the invitation link to the auth-service log.
# Production must configure Resend before invitations are enabled.
RESEND_API_KEY=
EMAIL_FROM=Cozema Health <no-reply@cozemahealth.com>
APP_URL=http://127.0.0.1:5173

# The FastAPI audit endpoint accepts signed organization changes from this
# service. Generate a distinct long secret for each environment.
AUTH_EVENT_WEBHOOK_URL=http://127.0.0.1:8080/internal/auth-events
AUTH_EVENT_WEBHOOK_SECRET=generate-a-different-long-random-value

# Google sign-in is optional, but the production values are separate from the
# Google Drive OAuth client used by FastAPI.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Do not configure cross-subdomain session cookies. Browser requests from the
# app use credentials: include, while the session cookie remains scoped to the
# auth service host.
