{
  "displayName": "Production: Drive watch scheduler failures",
  "documentation": {
    "content": "The Drive watch renewal Scheduler job failed. Check its OIDC service account, target audience, Cloud Run invocation permissions, and the Scheduler attempt log.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "environment": "production",
    "component": "cloud-scheduler"
  },
  "conditions": [
    {
      "displayName": "drive-watch-renewal execution logged an error",
      "conditionMatchedLog": {
        "filter": "resource.type=\"cloud_scheduler_job\" resource.labels.job_id=\"drive-watch-renewal\" severity>=ERROR"
      }
    }
  ],
  "combiner": "OR",
  "notificationChannels": [
    "projects/healthcare-credentialing-prod/notificationChannels/11678299693917119849"
  ],
  "alertStrategy": {
    "notificationRateLimit": {
      "period": "300s"
    },
    "autoClose": "1800s"
  }
}
