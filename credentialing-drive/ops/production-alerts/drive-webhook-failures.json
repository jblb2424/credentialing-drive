{
  "displayName": "Production: Drive webhook failures",
  "documentation": {
    "content": "The Google Drive webhook endpoint returned a 5xx response. Verify the active Drive channel, refresh-token status, and the processing queue.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "environment": "production",
    "component": "drive-webhook"
  },
  "conditions": [
    {
      "displayName": "Drive webhook returned a 5xx response",
      "conditionMatchedLog": {
        "filter": "resource.type=\"cloud_run_revision\" resource.labels.service_name=\"credentialing-drive\" httpRequest.requestUrl=~\"/webhooks/google-drive\" httpRequest.status>=500"
      }
    }
  ],
  "combiner": "OR",
  "notificationChannels": [
    "projects/healthcare-credentialing-prod/notificationChannels/11678299693917119849"
  ],
  "alertStrategy": {
    "notificationRateLimit": {
      "period": "300s"
    },
    "autoClose": "1800s"
  }
}
